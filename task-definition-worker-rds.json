{
  "family": "vueladata-worker-rds-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/vueladata-worker-rds-role",
  "containerDefinitions": [
    {
      "name": "worker-rds",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/vueladata/backend-workers:latest",
      "essential": true,
      "command": ["python", "-m", "worker_rds.main"],
      "environment": [
        {"name": "RABBITMQ_HOST", "value": "rabbitmq.vueladata.local"},
        {"name": "RABBITMQ_PORT", "value": "5672"},
        {"name": "RABBITMQ_USER", "value": "admin"},
        {"name": "RABBITMQ_PASS", "value": "admin123"},
        {"name": "QUEUE_RDS", "value": "q.rds_writer"},
        {"name": "PREFETCH_COUNT", "value": "10"},
        {"name": "DATABASE_URL", "value": "postgresql+psycopg://postgres:<PASSWORD>@<RDS_ENDPOINT>:5432/vueladata"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vueladata-worker-rds",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "worker-rds"
        }
      }
    }
  ]
}

